generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(cuid())
  name                 String   @default("")
  email                String?  @unique
  mobile               String?
  password             String?
  role                 String   @default("customer") // admin, store_owner, customer
  avatar               String?
  preferredCity        String?
  theme                String   @default("system")
  notificationsEnabled Boolean  @default(true)
  locationLat          Float?
  locationLng          Float?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  recentSearches       RecentSearch[]
  savedLocations       SavedLocation[]
  notifications        Notification[]
  store                Store?
  reminders            MedicineReminder[]
  reviews              PharmacyReview[]
  forumPosts           ForumPost[]
  forumReplies         ForumReply[]
  wishlistItems        WishlistItem[]
  familyMembers        FamilyMember[]
}

model Store {
  id            String   @id @default(cuid())
  ownerId       String   @unique
  name          String
  address       String
  city          String
  state         String
  country       String
  phone         String
  lat           Float?
  lng           Float?
  licenseNumber String?
  isOpen        Boolean  @default(true)
  workingHours  String   @default("8:00 AM - 10:00 PM")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  medicines     MedicineInventory[]
  reviews       PharmacyReview[]
  promotions    Promotion[]
}

model MedicineInventory {
  id            String   @id @default(cuid())
  storeId       String
  name          String
  genericName   String   @default("")
  manufacturer  String   @default("")
  category      String   @default("general")
  price         Float
  originalPrice Float
  discount      Int      @default(0)
  stockQuantity Int      @default(0)
  inStock       Boolean  @default(true)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model SavedLocation {
  id        String   @id @default(cuid())
  userId    String
  label     String
  address   String
  city      String
  state     String
  country   String
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecentSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Pincode {
  id      String @id @default(cuid())
  name    String
  pincode String
  state   String
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MedicineReminder {
  id            String   @id @default(cuid())
  userId        String
  medicineName  String
  dosage        String   @default("")
  frequency     String   @default("daily") // once, twice, thrice, daily, custom
  times         String   @default("08:00") // comma-separated times e.g. "08:00,14:00,20:00"
  startDate     DateTime @default(now())
  endDate       DateTime?
  isActive      Boolean  @default(true)
  notes         String   @default("")
  familyMemberId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMember  FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
}

model PharmacyReview {
  id          String   @id @default(cuid())
  userId      String
  storeId     String
  rating      Int      @default(5)
  serviceRating Int    @default(0)
  stockRating Int      @default(0)
  staffRating Int      @default(0)
  comment     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model ForumPost {
  id          String   @id @default(cuid())
  userId      String
  title       String
  content     String
  category    String   @default("general") // general, medicine, health, prescription, side-effects
  tags        String   @default("") // comma-separated
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     ForumReply[]
}

model ForumReply {
  id            String   @id @default(cuid())
  postId        String
  userId        String
  content       String
  isAI          Boolean  @default(false)
  isBestAnswer  Boolean  @default(false)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post          ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Doctor {
  id                String   @id @default(cuid())
  name              String
  specialty         String   @default("General Physician")
  clinicName        String   @default("")
  address           String   @default("")
  city              String   @default("")
  state             String   @default("")
  lat               Float?
  lng               Float?
  phone             String   @default("")
  rating            Float    @default(0)
  reviewCount       Int      @default(0)
  availableDays     String   @default("Mon-Fri") // comma-separated days
  availableHours    String   @default("9:00 AM - 5:00 PM")
  consultationFee   Float    @default(0)
  isVerified        Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Promotion {
  id              String   @id @default(cuid())
  storeId         String
  title           String
  description     String   @default("")
  discountPercent Int      @default(0)
  code            String   @default("")
  startDate       DateTime @default(now())
  endDate         DateTime?
  isActive        Boolean  @default(true)
  promoType       String   @default("discount") // discount, flash_sale, loyalty, bogo
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id            String   @id @default(cuid())
  userId        String
  medicineName  String
  genericName   String   @default("")
  category      String   @default("")
  dosage        String   @default("")
  notes         String   @default("")
  storeId       String?
  addedAt       DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id            String   @id @default(cuid())
  userId        String
  name          String
  relation      String   @default("other") // self, parent, child, spouse, sibling, other
  age           Int?
  weight        Float?
  gender        String   @default("")
  bloodGroup    String   @default("")
  avatar        String?
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders     MedicineReminder[]
}

model HealthArticle {
  id            String   @id @default(cuid())
  title         String
  content       String
  summary       String   @default("")
  category      String   @default("general") // wellness, nutrition, exercise, seasonal, mental-health, prevention
  author        String   @default("Medicine Finder Team")
  imageUrl      String?
  tags          String   @default("") // comma-separated
  isFeatured    Boolean  @default(false)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}